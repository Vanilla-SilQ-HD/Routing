{
  "$schema": "https://json-schema.org/draft-2020-12/schema",
  "title": "Routing probes",
  "type": "object",
  "required": ["domains", "expectations"],
  "properties": {
    "note": {"type": "string"},
    "domains": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "expectations": {
      "type": "object",
      "additionalProperties": {"enum": ["VPN", "Direct"]}
    }
  }
}
