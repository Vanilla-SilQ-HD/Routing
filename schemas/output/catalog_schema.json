{
  "$schema": "https://json-schema.org/draft-2020-12/schema",
  "title": "AWG Manager catalog",
  "description": "Каталог наборов правил для импорта в AWG Manager.",
  "type": "object",
  "required": ["generated", "sources"],
  "additionalProperties": false,
  "properties": {
    "generated": {"type": "string", "description": "Время генерации каталога."},
    "sources": {
      "type": "array",
      "description": "Единственный источник набора правил Routing.",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "url", "names"],
        "additionalProperties": false,
        "properties": {
          "id": {"const": "routing", "description": "Идентификатор источника."},
          "url": {"type": "string", "pattern": "^https://.*\\{\\}", "description": "HTTPS-шаблон URL релиза: {} заменяется именем набора."},
          "names": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}, "description": "Доступные имена наборов из routing/datasets.py."}
        }
      }
    }
  }
}
