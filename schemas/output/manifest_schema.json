{
  "$schema": "https://json-schema.org/draft-2020-12/schema",
  "title": "Routing build manifest",
  "type": "object",
  "required": ["schema_version", "built_at", "offline_replay", "sources", "output", "validation", "configuration_sha256", "compiler", "environment", "scope", "core", "smart", "service_networks", "registry_ip", "registry_cidr", "direct_exceptions", "domain_diff"],
  "properties": {
    "schema_version": {"const": 1},
    "built_at": {"type": "string"},
    "offline_replay": {"type": "boolean"},
    "sources": {"type": "array", "minItems": 1},
    "public_suffix_list": {"type": "object"},
    "output": {
      "type": "object",
      "required": ["total_conditions", "exact", "suffix", "srs_bytes", "files"],
      "properties": {
        "total_conditions": {"type": "integer", "minimum": 1},
        "exact": {"type": "integer", "minimum": 0},
        "suffix": {"type": "integer", "minimum": 0},
        "srs_bytes": {"type": "integer", "minimum": 1},
        "files": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
      }
    },
    "validation": {
      "type": "object",
      "required": ["baseline", "warnings"],
      "properties": {
        "baseline": {"enum": ["first-build", "previous-successful-or-approved-manifest", "large-change-candidate"]},
        "baseline_built_at": {"type": "string"},
        "warnings": {"type": "array", "items": {"type": "string"}}
      }
    },
    "configuration_sha256": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[a-f0-9]{64}$"}},
    "compiler": {"type": "object"},
    "environment": {
      "type": "object",
      "required": ["github_commit"],
      "properties": {
        "python": {"type": "string"},
        "idna": {"type": "string"},
        "github_commit": {"type": ["string", "null"]},
        "repository": {"type": "string"}
      }
    },
    "scope": {"type": "object"},
    "core": {"type": "object"},
    "smart": {"type": "object"},
    "service_networks": {"type": "object"},
    "registry_ip": {"type": "object"},
    "registry_cidr": {"type": "object"},
    "direct_exceptions": {"type": "object"},
    "domain_diff": {"type": "object"},
    "domain_changes": {"type": "object"},
    "counts": {"type": "object"},
    "exact_intersections_before_minimization": {"type": "array"},
    "manual_vpn": {"type": "object"},
    "elapsed_seconds": {"type": "number"}
  }
}
