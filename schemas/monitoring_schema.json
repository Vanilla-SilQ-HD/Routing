{
  "$schema": "https://json-schema.org/draft-2020-12/schema",
  "title": "Monitoring configuration",
  "type": "object",
  "required": ["schema_version", "provider", "targets"],
  "properties": {
    "schema_version": {"const": 1},
    "description": {"type": "string"},
    "provider": {
      "type": "object",
      "required": ["name", "url", "country", "probes_per_target", "timeout_seconds"],
      "properties": {
        "name": {"type": "string"},
        "url": {"type": "string", "pattern": "^https://"},
        "country": {"type": "string", "minLength": 2, "maxLength": 2},
        "probes_per_target": {"type": "integer", "minimum": 1, "maximum": 10},
        "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 600}
      }
    },
    "targets": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "direct_targets": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "rotation": {
      "type": "object",
      "required": ["sample_size", "source_url", "stale_threshold"],
      "additionalProperties": false,
      "properties": {
        "sample_size": {"type": "integer", "minimum": 1, "maximum": 20},
        "source_url": {"type": "string", "pattern": "^https://"},
        "stale_threshold": {"type": "integer", "minimum": 2, "maximum": 20}
      }
    }
  }
}
