{
  "$schema": "https://json-schema.org/draft-2020-12/schema",
  "title": "Service network sources",
  "type": "object",
  "required": ["schema_version", "sources", "validation"],
  "properties": {
    "schema_version": {"const": 1},
    "note": {"type": "string"},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "service", "url", "reference", "description", "format", "max_bytes", "min_entries", "max_entries", "min_ipv4_entries", "min_ipv6_entries", "min_ipv4_prefix_length", "min_ipv6_prefix_length", "max_ipv4_addresses", "max_ipv6_addresses"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "service": {"type": "string"},
          "url": {"type": "string", "pattern": "^https://"},
          "reference": {"type": "string"},
          "description": {"type": "string"},
          "format": {"enum": ["cidr-lines", "ripe-ris-prefixes"]},
          "max_bytes": {"type": "integer", "minimum": 1},
          "min_entries": {"type": "integer", "minimum": 1},
          "max_entries": {"type": "integer", "minimum": 1},
          "min_ipv4_entries": {"type": "integer", "minimum": 0},
          "min_ipv6_entries": {"type": "integer", "minimum": 0},
          "min_ipv4_prefix_length": {"type": "integer", "minimum": 0, "maximum": 32},
          "min_ipv6_prefix_length": {"type": "integer", "minimum": 0, "maximum": 128},
          "max_ipv4_addresses": {"type": "integer", "minimum": 1},
          "max_ipv6_addresses": {"type": "integer", "minimum": 1},
          "asn": {"type": "integer", "minimum": 1},
          "expected_holder": {"type": "string"},
          "max_snapshot_age_hours": {"type": "integer", "minimum": 1},
          "identity_source": {"type": "object"}
        }
      }
    },
    "validation": {
      "type": "object",
      "required": ["max_drop_fraction", "max_growth_fraction"],
      "properties": {
        "max_drop_fraction": {"type": "number", "minimum": 0, "maximum": 1},
        "max_growth_fraction": {"type": "number", "minimum": 0}
      }
    }
  }
}
