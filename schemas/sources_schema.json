{
  "$schema": "https://json-schema.org/draft-2020-12/schema",
  "title": "Domain sources",
  "type": "object",
  "required": ["sources", "public_suffix_list"],
  "properties": {
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "url", "format", "min_entries", "max_bytes", "description"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "url": {"type": "string", "pattern": "^https://"},
          "format": {"enum": ["suffix-lines", "singbox-domains"]},
          "min_entries": {"type": "integer", "minimum": 1},
          "max_bytes": {"type": "integer", "minimum": 1},
          "description": {"type": "string", "minLength": 1},
          "reference": {"type": "string"},
          "caveat": {"type": "string"},
          "aggregates": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
        }
      }
    },
    "core_excluded_sources": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "public_suffix_list": {
      "type": "object",
      "required": ["id", "url", "max_bytes", "min_entries", "description"],
      "properties": {
        "id": {"type": "string"},
        "url": {"type": "string", "pattern": "^https://"},
        "max_bytes": {"type": "integer", "minimum": 1},
        "min_entries": {"type": "integer", "minimum": 1},
        "description": {"type": "string"}
      }
    }
  }
}
