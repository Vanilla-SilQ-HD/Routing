{
  "$schema": "https://json-schema.org/draft-2020-12/schema",
  "title": "Routing policy",
  "type": "object",
  "required": ["schema_version", "shared_roots", "service_owned_suffixes", "validation"],
  "properties": {
    "schema_version": {"const": 1},
    "description": {"type": "string"},
    "shared_roots": {"type": "object", "additionalProperties": {"type": "string"}},
    "service_owned_suffixes": {"type": "object", "additionalProperties": {"type": "string"}},
    "network": {
      "type": "object",
      "required": ["timeout_seconds", "total_timeout_seconds", "retries", "backoff_base", "backoff_max", "max_workers"],
      "additionalProperties": false,
      "properties": {
        "timeout_seconds": {"type": "number", "exclusiveMinimum": 0},
        "total_timeout_seconds": {"type": "number", "exclusiveMinimum": 0},
        "retries": {"type": "integer", "minimum": 1, "maximum": 10},
        "backoff_base": {"type": "number", "minimum": 0},
        "backoff_max": {"type": "number", "exclusiveMinimum": 0},
        "max_workers": {"type": "integer", "minimum": 1, "maximum": 16}
      }
    },
    "validation": {
      "type": "object",
      "required": ["max_invalid_fraction", "minimum_output_domains", "max_source_drop_fraction", "max_source_growth_fraction", "max_output_drop_fraction", "max_output_growth_fraction", "max_previous_age_days", "maximum_registry_ips", "max_service_stale_hours", "registry_ip"],
      "properties": {
        "max_invalid_fraction": {"type": "number", "minimum": 0, "maximum": 1},
        "minimum_output_domains": {"type": "integer", "minimum": 1},
        "max_source_drop_fraction": {"type": "number", "minimum": 0, "maximum": 1},
        "max_source_growth_fraction": {"type": "number", "minimum": 0},
        "max_output_drop_fraction": {"type": "number", "minimum": 0, "maximum": 1},
        "max_output_growth_fraction": {"type": "number", "minimum": 0},
        "max_previous_age_days": {"type": "integer", "minimum": 1},
        "maximum_registry_ips": {"type": "integer", "minimum": 1},
        "max_service_stale_hours": {"type": "integer", "minimum": 1},
        "registry_ip": {
          "type": "object",
          "required": ["max_drop_fraction", "max_growth_fraction"],
          "properties": {
            "max_drop_fraction": {"type": "number", "minimum": 0, "maximum": 1},
            "max_growth_fraction": {"type": "number", "minimum": 0}
          }
        }
      }
    }
  }
}
